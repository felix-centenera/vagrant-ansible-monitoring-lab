Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"

  machines = [
    {
      name: "so-lab-node-01",
      hostname: "node01",
      ip: "192.168.56.11",
      memory: 1024,
      cpus: 1
    },
    {
      name: "so-lab-node-02",
      hostname: "node02",
      ip: "192.168.56.12",
      memory: 1024,
      cpus: 1
    }
  ]

  machines.each do |machine|
    config.vm.define machine[:name] do |node|
      node.vm.hostname = machine[:hostname]

      # Red privada accesible desde la máquina host.
      # Esto nos permite ejecutar Ansible desde nuestro equipo local.
      node.vm.network "private_network", ip: machine[:ip]

      node.vm.provider "virtualbox" do |vb|
        vb.name = machine[:name]
        vb.memory = machine[:memory]
        vb.cpus = machine[:cpus]
      end

      # Provisioning mínimo para preparar SSH y herramientas básicas.
      node.vm.provision "shell", inline: <<-SHELL
        apt-get update -y
        apt-get install -y python3 python3-apt curl vim net-tools

        echo "VM preparada para Ansible"
      SHELL
    end
  end
end